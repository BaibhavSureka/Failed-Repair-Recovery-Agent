# Local, synthetic demo only. No API key is required.
DEMO_MODE=true
DEMO_DATE=2026-10-21
DATABASE_PATH=./data/demo.sqlite3
# Set DATABASE_URL for Supabase/PostgreSQL deployments. It takes precedence over DATABASE_PATH.
DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Server-side Next.js proxy. Do not use NEXT_PUBLIC_ for secrets.
BACKEND_URL=http://127.0.0.1:8000
# Optional server-side Bolna integration. Calls consume Bolna credits.
BOLNA_API_KEY=
BOLNA_AGENT_ID=
# Optional future LLM extraction; deterministic text extraction remains the default.
LLM_API_KEY=
